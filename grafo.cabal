cabal-version:      2.4
name:               grafo-espectral
version:            0.1.0.0
build-type:         Simple

executable grafo-espectral
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Types, Matrix, Laplacian, Components, Rank, Dot, Consenso
    build-depends:    base >=4.18 && <5
    default-language: Haskell2010
    ghc-options:      -Wall