graph G {
  node [shape=circle];
  subgraph cluster_0 {
    label="Componente 1";
    color=blue;
    node [color=blue];
    edge [color=blue];
    0;
    1;
    2;
    0 -- 1;
    0 -- 2;
    1 -- 2;
  }
  subgraph cluster_1 {
    label="Componente 2";
    color=red;
    node [color=red];
    edge [color=red];
    3;
    4;
    3 -- 4;
  }
}
